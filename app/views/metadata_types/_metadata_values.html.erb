<% frame_id = dom_id(metadata_type, :metadata_values) %>
<% search_id = dom_id(metadata_type, :metadata_value_search) %>
<% status_id = dom_id(metadata_type, :metadata_value_status) %>
<% frame_params = {
  q: search_query.presence,
  status: review_filter == "all" ? nil : review_filter,
  limit: metadata_values_limit
}.compact %>
<% can_create_metadatum = policy(Metadatum.new(metadata_type: metadata_type)).new? %>

<%= turbo_frame_tag frame_id do %>
  <div class="row g-3 pb-3">
    <%= form_with(
      url: metadata_values_metadata_type_path(metadata_type),
      method: :get,
      class: "col-12 col-sm-10",
      data: {
        controller: "metadata-values-form",
        turbo_frame: frame_id
      }
    ) do |form| %>
      <div class="row g-3">
        <div class="col-12 col-md-6 col-lg-4">
          <%= form.label :q, "Metadata Search", for: search_id, class: "form-label" %>
          <%= form.search_field :q,
            value: search_query,
            id: search_id,
            class: "form-control",
            data: {
              action: "input->metadata-values-form#submit",
              turbo_permanent: true
            }
          %>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
          <%= form.label :status, "Status", for: status_id, class: "form-label" %>
          <%= form.select :status,
            options_for_select(
              [
                ["All", "all"],
                ["Under Review", "under_review"],
                ["Reviewed", "reviewed"]
              ],
              review_filter
            ),
            {},
            id: status_id,
            class: "form-select",
            data: { action: "change->metadata-values-form#submit" }
          %>
        </div>
      </div>

      <%= form.hidden_field :limit, value: metadata_values_limit %>
    <% end %>

    <% if can_create_metadatum %>
      <div class="col-12 col-sm-2 d-grid align-items-end">
        <%= link_to "Add",
          new_metadata_type_metadatum_path(metadata_type, frame_params),
          class: "btn btn-primary",
          data: { turbo_frame: "modal" }
        %>
      </div>
    <% end %>
  </div>

  <div class="row">
    <div class="col border rounded">
      <div class="row py-2 border-bottom">
        <div class="col-6">
          <h3 class="fs-6 mb-0">Metadata Value</h3>
        </div>
        <div class="col-5">
          <h3 class="fs-6 mb-0">Status</h3>
        </div>
        <div class="col-1"></div>
      </div>

      <% if metadata_values.any? %>
        <%= render partial: "metadata/metadatum",
          collection: metadata_values,
          locals: {
            metadata_type: metadata_type,
            frame_params: frame_params
          }
        %>
      <% else %>
        <p class="text-center my-5">No metadata values found.</p>
      <% end %>
    </div>
  </div>

  <% if metadata_values_count > metadata_values_limit %>
    <% show_more_params = frame_params.merge(limit: metadata_values_next_limit) %>

    <div class="row justify-content-center mt-3">
      <div class="col-auto">
        <%= link_to "Show More",
          metadata_values_metadata_type_path(metadata_type, show_more_params),
          class: "btn btn-outline-secondary",
          data: { turbo_frame: frame_id }
        %>
      </div>
    </div>
  <% end %>
<% end %>
