<%= form_with(model: metadata_type, data: { turbo_frame: "modal" }) do |form| %>
  <% if metadata_type.errors.any? %>
    <div class="alert alert-danger">
      <p class="mb-2"><%= pluralize(metadata_type.errors.count, "error") %> prevented this metadata type from being saved:</p>
      <ul class="mb-0">
        <% metadata_type.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, "Name", class: "form-label" %>
    <%= form.text_field :name, class: "form-control", autofocus: true %>
  </div>

  <% if policy(metadata_type).permitted_attributes.include?(:access_level) %>
    <div class="mb-3">
      <%= form.label :access_level, "Access level", class: "form-label" %>
      <%= form.select :access_level,
        options_for_select(metadata_access_level_options, metadata_type.access_level),
        {},
        class: "form-select"
      %>
    </div>
  <% end %>

  <div class="modal-footer px-0 pb-0">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
