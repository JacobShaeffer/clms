<div id="<%= dom_id metadata_type %>" class="row">
  <% accordion_id = dom_id(metadata_type, :accordion) %>
  <% collapse_id = dom_id(metadata_type, :collapse) %>
  <% frame_id = dom_id(metadata_type, :metadata_values) %>
  <% metadata_counts = local_assigns[:metadata_counts] %>
  <% metadata_count = metadata_counts ? metadata_counts.fetch(metadata_type.id, 0) : metadata_type.metadata.count %>

  <div
    class="accordion pb-2"
    id="<%= accordion_id %>"
    data-controller="metadata-values-frame"
    data-metadata-values-frame-url-value="<%= metadata_values_metadata_type_path(metadata_type) %>"
  >
    <div class="accordion-item">
      <h2 class="accordion-header">
        <button
          class="accordion-button collapsed"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#<%= collapse_id %>"
          data-action="click->metadata-values-frame#load"
          aria-expanded="false"
          aria-controls="<%= collapse_id %>"
        >
          <span class="h2 mb-0"><%= metadata_type.name %></span>
          <span id="<%= dom_id(metadata_type, :metadata_count) %>" class="badge text-bg-warning ms-2"><%= metadata_count %></span>
        </button>
      </h2>

      <div id="<%= collapse_id %>" class="accordion-collapse collapse">
        <div class="accordion-body">
          <%= turbo_frame_tag frame_id, data: { metadata_values_frame_target: "frame" } do %>
            <div class="metadata-values-placeholder" aria-hidden="true">
              <div class="row pb-3 placeholder-glow">
                <div class="col-10">
                  <div class="row">
                    <div class="col col-lg-4">
                      <span class="placeholder col-5 mb-2"></span>
                      <span class="placeholder col-12 rounded" style="height: 2.375rem;"></span>
                    </div>
                    <div class="col col-lg-3">
                      <span class="placeholder col-4 mb-2"></span>
                      <span class="placeholder col-12 rounded" style="height: 2.375rem;"></span>
                    </div>
                  </div>
                </div>
                <div class="col-2 d-flex justify-content-end align-items-end">
                  <span class="placeholder col-8 rounded" style="height: 2.375rem;"></span>
                </div>
              </div>

              <div class="row">
                <div class="col border">
                  <div class="row py-2 placeholder-glow">
                    <div class="col-6">
                      <span class="placeholder col-5"></span>
                    </div>
                    <div class="col-5">
                      <span class="placeholder col-4"></span>
                    </div>
                    <div class="col-1"></div>
                  </div>

                  <% 4.times do %>
                    <div class="row py-2 placeholder-glow">
                      <div class="col-6">
                        <span class="placeholder col-8"></span>
                      </div>
                      <div class="col-5">
                        <span class="placeholder col-5"></span>
                      </div>
                      <div class="col-1">
                        <span class="placeholder rounded-circle" style="width: 2rem; height: 2rem;"></span>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
            <span class="visually-hidden">Loading metadata values...</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
