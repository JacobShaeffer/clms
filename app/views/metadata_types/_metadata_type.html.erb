
<!--
      :open_accordions => @open_accordions,
      :metadata_type_searches => @metadata_type_searches,
      :metadata_type_review_filters => @metadata_type_review_filters,
      :metadata_type_metadata_counts => @metadata_type_metadata_counts,
      :metadata_type_metadata => @metadata_type_metadata,
      :metadata_type_modal => @metadata_type_modal,
      :metadatum_modal => @metadatum_modal
-->

<div id="<%= dom_id metadata_type %>" class="row">
  <% accordion_id = dom_id(metadata_type, :accordion) %>
  <% collapse_id = dom_id(metadata_type, :collapse) %>
  <% is_open = @open_accordions.include?(metadata_type.id) %>
  <div class="accordion pb-2" id="<%= accordion_id %>">
    <div class="accordion-item">
      <h2 class="accordion-header">
        <button 
          class="accordion-button <%= is_open ? "" : "collapsed" %>" 
          type="button" 
          data-metadata-state-id-param="<%= metadata_type.id %>"
          data-action="metadata-state#on_accordion_toggle"
          aria-expanded="<%= is_open ? "true" : "false" %>" 
          aria-controls="<%= collapse_id %>"
        >
          <h2><%= metadata_type.name %></h2>
          <span class="badge text-bg-warning"><%= metadata_type.metadata.count %></span>
        </button>
      </h2>
      <div 
        id="<%= collapse_id %>" 
        class="accordion-collapse <%= is_open ? "show" : "collapse" %>" 
        data-bs-parent="<%= accordion_id %>"
      >
        <div class="accordion-body">
<!-- Button trigger modal -->
<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">
  Launch demo modal
</button>
          <div class="row pb-3">
            <form class="col-10">
              <div class="row">
                <div class="col col-lg-4">
                  <% metadata_value_id = dom_id(metadata_type, :metadata_value) %>
                  <label for="<%= metadata_value_id %>">Metadata Value</label>
                  <input 
                    class="form-control" 
                    id="<%= metadata_value_id %>" 
                    value="<%= @metadata_type_searches[metadata_type.id] %>"
                    data-action="metadata-state#search" 
                    data-metadata-state-id-param="<%= metadata_type.id %>"
                    data-metadata-state-target="query"
                  >
                </div>
                <div class="col col-lg-3">
                  <% status_id = dom_id(metadata_type, :status) %>
                  <label for="<%= status_id %>">Status</label>
                  <select 
                    class="form-select" 
                    id="<%= status_id %>"
                    data-action="metadata-state#filter" 
                    data-metadata-state-id-param="<%= metadata_type.id %>"
                    data-metadata-state-target="filter"
                  >
                    <%
                      local_filter = "none"
                      if @metadata_type_review_filters.key?(metadata_type.id)
                        local_filter = @metadata_type_review_filters[metadata_type.id]
                      end
                    %>
                    <option 
                      <%= local_filter == "none" ? "selected" : "" %> 
                      value="all"
                    >All</option>
                    <option 
                      <%= local_filter == "true" ? "selected" : "" %> 
                      value="UR"
                    >Under Review</option>
                    <option 
                      <%= local_filter == "false" ? "selected" : "" %> 
                      value="R"
                    >Reviewed</option>
                  </select>
                </div>
              </div>
            </form>
            <div class="col-2">
              <button class="btn float-end btn-primary">Add</button>
            </div>
          </div>
          <div class="row">
            <div class="col" style="border: 1px solid black;">
              <div class="row">
                <div class="col-6">
                  <h3>Metadata Value</h3>
                </div>
                <div class="col-5">
                  <h3>Status</h3>
                </div>
                <div class="col-1">
                </div>
              </div>
              <%= render partial: "metadata/metadatum", collection: @metadata_types_values[metadata_type.id] %>
            </div>
          </div>
          <div class="row justify-content-center">
            <div class="col-auto">
              <a href="#">Show More</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
