<% content_for :title, "Metadata types" %>

<div class="row align-items-center g-3 mb-4">
  <div class="col-12 col-sm">
    <div class="d-flex align-items-center gap-2">
      <h1 class="mb-0">Metadata types</h1>
      <% if policy(MetadataType).manage? %>
        <%= link_to "⋮",
          edit_all_metadata_types_path,
          class: "btn btn-outline-secondary fs-4 lh-1 px-2",
          role: "button",
          aria: { label: "Edit metadata types" },
          data: { turbo_frame: "modal" }
        %>
      <% end %>
    </div>
  </div>
  <% if policy(MetadataType).new? %>
    <div class="col-12 col-sm-auto d-grid">
      <%= link_to "New metadata type", new_metadata_type_path, class: "btn btn-primary", data: { turbo_frame: "modal" } %>
    </div>
  <% end %>
</div>

<div id="metadata-types">
  <%= render "metadata_types/metadata_types",
    metadata_types: @metadata_types,
    metadata_counts: @metadata_counts
  %>
</div>

<%= turbo_frame_tag "modal" %>
