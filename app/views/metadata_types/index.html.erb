<% content_for :title, "Metadata types" %>

<div class="row">
  <div class="col">
    <h1 class="title">Metadata types</h1>
  </div>
  <div class="col align-self-center">
    <%= link_to "New metadata type", new_metadata_type_path, class: "btn btn-primary float-end", data: { turbo_frame: "modal" } %>
  </div>
</div>

<div id="metadata-types">
  <%= render partial: "metadata_types/metadata_type",
    collection: @metadata_types,
    as: :metadata_type,
    locals: { metadata_counts: @metadata_counts }
  %>
</div>

<%= turbo_frame_tag "modal" %>
