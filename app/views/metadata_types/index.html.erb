<% content_for :title, "Metadata types" %>

<div class="row">
  <div class="col">
    <h1 class="title">Metadata types</h1>
  </div>
  <div class="col align-self-center">
    <%= link_to "New metadata type", new_metadata_type_path, class: "btn btn-primary float-end" %>
  </div>
</div>

<!-- <div id="metadata-types" data-controller="accordion-state"> -->
<div 
  id="metadata-types" 
  data-controller="metadata-state"
  data-metadata-state-open-accordions-value="<%= @open_accordions.to_json %>"
  data-metadata-state-metadata-type-searches-value="<%= @metadata_type_searches.to_json %>"
  data-metadata-state-metadata-type-review-filters-value="<%= @metadata_type_review_filters.to_json %>"
  data-metadata-state-metadata-type-metadata-counts-value="<%= @metadata_type_metadata_counts.to_json %>"
  data-metadata-state-metadata-type-modal-value="<%= @metadata_type_modal %>"
  data-metadata-state-metadatum-modal-value="<%= @metadatum_modal %>"
>
  <%= render @metadata_types, 
    :locals => {
      :open_accordions => @open_accordions,
      :metadata_type_searches => @metadata_type_searches,
      :metadata_type_review_filters => @metadata_type_review_filters,
      :metadata_type_metadata_counts => @metadata_type_metadata_counts,
      :metadata_type_metadata => @metadata_type_metadata,
      :metadata_type_modal => @metadata_type_modal,
      :metadatum_modal => @metadatum_modal
    } 
  %>
</div>
