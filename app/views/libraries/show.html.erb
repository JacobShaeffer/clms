<% content_for :title, @library.name %>

<div class="my-4">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
      <h1 class="mb-1"><%= @library.name %></h1>
      <p class="text-body-secondary mb-0">
        Version <%= @library.current_version.version_number %>
      </p>
    </div>

    <%= link_to "Back to libraries", libraries_path, class: "btn btn-outline-secondary" %>
  </div>

  <h2 class="h4 mb-3">Folders</h2>

  <% if @root_folders.any? %>
    <div id="library-folders" class="list-group">
      <% @root_folders.each do |folder| %>
        <div id="<%= dom_id folder %>" class="list-group-item">
          <%= folder.name %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-body-secondary">No root folders found.</p>
  <% end %>
</div>
