<% content_for :title, @library.name %>

<div
  class="my-4"
  data-controller="library-folder-actions library-content-selection"
  data-action="turbo:frame-load->library-folder-actions#sync change->library-content-selection#update turbo:frame-render@document->library-content-selection#frameRendered content-table-selection:connected->library-content-selection#tableConnected">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
      <h1 class="mb-1"><%= @library.name %></h1>
      <div class="dropdown">
        <button
          class="btn btn-sm btn-outline-secondary dropdown-toggle"
          type="button"
          id="library-version-dropdown"
          data-bs-toggle="dropdown"
          aria-expanded="false"
          aria-label="Library version">
          <%= @library_version.version_number %>
        </button>
        <ul class="dropdown-menu" aria-labelledby="library-version-dropdown">
          <% @library_versions.each do |library_version| %>
            <% selected = library_version.id == @library_version.id %>
            <li>
              <%= link_to library_path(
                @library,
                library_version_id: (library_version.id unless library_version.id == @library.current_version_id)
              ),
                class: "dropdown-item #{"active" if selected}",
                aria: { current: ("true" if selected) } do %>
                <%= library_version.version_number %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
      <% if policy(LibraryVersion).create? %>
        <%= link_to "New version",
          new_library_library_version_path(@library),
          class: "btn btn-primary",
          data: { turbo_frame: "modal" } %>
      <% end %>
      <%= link_to "Back to libraries", libraries_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-12 <%= "col-lg-4" if @viewing_current_version %>">
      <%= render "libraries/folder_browser" %>
    </div>

    <% if @viewing_current_version %>
      <div class="col-12 col-lg-8">
        <%= render "libraries/content_panel" %>
      </div>
    <% end %>
  </div>
</div>

<%= turbo_frame_tag "modal" %>
