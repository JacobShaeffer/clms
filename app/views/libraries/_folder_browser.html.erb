<%= turbo_frame_tag dom_id(@library, :folder_browser), data: { turbo_action: "advance" } do %>
  <section
    class="border rounded p-3"
    aria-labelledby="library-folder-browser-heading"
    data-controller="library-folder-selection"
    data-action="change->library-folder-selection#update turbo:before-cache@document->library-folder-selection#clear"
    data-library-folder-actions-target="folderState"
    data-folder-id="<%= @current_folder&.id %>">
    <h2 id="library-folder-browser-heading" class="h4 mb-3">Library folder browser</h2>

    <nav aria-label="Library folder breadcrumb">
      <ol class="breadcrumb flex-nowrap overflow-x-auto">
        <% root_is_current = @current_folder.nil? %>
        <li class="breadcrumb-item <%= "active" if root_is_current %>" <%= "aria-current=page" if root_is_current %>>
          <% if root_is_current %>
            <%= @library.name %>
          <% else %>
            <%= link_to @library.name,
              library_path(
                @library,
                tab: @active_tab,
                shelf_id: @selected_shelf&.id
              ),
              data: {
                turbo_frame: dom_id(@library, :folder_browser),
                turbo_action: "advance"
              }
            %>
          <% end %>
        </li>

        <% @breadcrumb_folders.each_with_index do |folder, index| %>
          <% current = index == @breadcrumb_folders.length - 1 %>
          <li class="breadcrumb-item <%= "active" if current %>" <%= "aria-current=page" if current %>>
            <% if current %>
              <%= folder.name %>
            <% else %>
              <%= link_to folder.name,
                library_path(
                  @library,
                  folder_id: folder.id,
                  tab: @active_tab,
                  shelf_id: @selected_shelf&.id
                ),
                data: {
                  turbo_frame: dom_id(@library, :folder_browser),
                  turbo_action: "advance"
                }
              %>
            <% end %>
          </li>
        <% end %>
      </ol>
    </nav>

    <%= form_with(
      url: move_library_folder_selection_path(@library),
      method: :get,
      data: { turbo_frame: "modal" }
    ) do %>
      <%= hidden_field_tag :source_folder_id, @current_folder&.id %>
      <%= hidden_field_tag :tab, @active_tab %>
      <%= hidden_field_tag :shelf_id, @selected_shelf&.id if @selected_shelf %>

      <% if policy(LibraryFolder).manage? %>
        <div class="d-flex flex-wrap justify-content-end gap-2 mb-3">
          <div
            class="d-none d-flex gap-2"
            hidden
            data-library-folder-selection-target="actions">
            <%= button_tag "Move",
              type: "submit",
              name: nil,
              class: "btn btn-warning",
              formaction: move_library_folder_selection_path(@library),
              formmethod: "get"
            %>
            <%= button_tag "Remove",
              type: "submit",
              name: nil,
              class: "btn btn-danger",
              formaction: remove_confirmation_library_folder_selection_path(@library),
              formmethod: "get"
            %>
            <%= button_tag "Duplicate",
              type: "submit",
              name: nil,
              class: "btn btn-secondary",
              formaction: duplicate_library_folder_selection_path(@library),
              formmethod: "get"
            %>
          </div>
          <%= link_to "New Folder",
            new_library_library_folder_path(
              @library,
              parent_folder_id: @current_folder&.id,
              tab: @active_tab,
              shelf_id: @selected_shelf&.id
            ),
            class: "btn btn-success",
            data: { turbo_frame: "modal" }
          %>
        </div>
      <% end %>

      <div
        class="list-group"
        id="library-folder-browser-items">
        <% @browser_folders.each do |folder| %>
          <div id="<%= dom_id(folder, :browser) %>" class="list-group-item d-flex align-items-center gap-2">
            <%= check_box_tag "folder_ids[]",
              folder.id,
              false,
              id: dom_id(folder, :browser_selection),
              class: "form-check-input flex-shrink-0",
              aria: { label: "Select folder #{folder.name}" },
              data: { library_folder_selection_target: "item" }
            %>
            <%= link_to folder.name,
              library_path(
                @library,
                folder_id: folder.id,
                tab: @active_tab,
                shelf_id: @selected_shelf&.id
              ),
              class: "link-body-emphasis",
              data: {
                turbo_frame: dom_id(@library, :folder_browser),
                turbo_action: "advance"
              }
            %>
            <span class="badge text-bg-secondary ms-auto">Folder</span>
          </div>
        <% end %>

        <% @browser_contents.each do |content| %>
          <div id="<%= dom_id(content, :browser) %>" class="list-group-item d-flex align-items-center gap-2">
            <%= check_box_tag "content_ids[]",
              content.id,
              false,
              id: dom_id(content, :browser_selection),
              class: "form-check-input flex-shrink-0",
              aria: { label: "Select content #{content.title}" },
              data: { library_folder_selection_target: "item" }
            %>
            <span><%= content.title %></span>
            <div class="d-flex align-items-center gap-2 ms-auto">
              <% if @file_changed_content_ids.key?(content.id) %>
                <span class="badge text-bg-warning">File changed</span>
              <% end %>
              <span class="badge text-bg-light">Content</span>
            </div>
          </div>
        <% end %>

        <% if @browser_folders.empty? && @browser_contents.empty? %>
          <p class="list-group-item text-center text-body-secondary mb-0">
            <%= @current_folder ? "This folder is empty." : "No root folders found." %>
          </p>
        <% end %>
      </div>
    <% end %>
  </section>
<% end %>
