<%= form_with(
  url: add_to_active_folder_library_path(@library),
  method: :post,
  id: definition.selection_form_id,
  class: "text-end",
  data: {
    action: "submit->library-content-selection#prepareSubmit turbo:submit-end->library-content-selection#clearAfterSubmit"
  }
) do %>
  <%= hidden_field_tag :folder_id,
    current_folder&.id,
    data: { library_folder_actions_target: "folderInput" }
  %>
  <%= hidden_field_tag :tab, active_tab %>
  <%= hidden_field_tag :shelf_id, selected_shelf&.id if selected_shelf %>

  <%= submit_tag "Add to Active Folder",
    class: "btn btn-primary"
  %>

  <div
    id="<%= LibrariesController::ADD_TO_ACTIVE_FOLDER_STATUS_ID %>"
    class="small mt-2"
    role="status"
    aria-live="polite"></div>
<% end %>
