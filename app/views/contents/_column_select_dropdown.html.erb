<div class="dropdown">
  <button
    class="btn btn-secondary dropdown-toggle"
    type="button"
    id="contents-column-select-dropdown"
    data-bs-toggle="dropdown"
    data-bs-auto-close="outside"
    aria-expanded="false">
    Column select
  </button>

  <div class="dropdown-menu p-3 shadow" aria-labelledby="contents-column-select-dropdown" style="min-width: 18rem; max-height: 70vh; overflow-y: auto;">
    <%= form_with(
      url: table_contents_path,
      method: :get,
      data: {
        controller: "content-column-select",
        turbo_frame: "contents_table",
        action: "change->content-column-select#submit"
      }
    ) do %>
      <%= hidden_field_tag :columns_present, "1" %>

      <h2 class="h6">Content columns</h2>
      <% content_columns.each do |column| %>
        <% checkbox_id = "content_column_#{column[:key]}" %>
        <div class="form-check form-switch">
          <%= check_box_tag "columns[]",
            column[:key],
            selected_column_keys.include?(column[:key]),
            id: checkbox_id,
            class: "form-check-input",
            role: "switch"
          %>
          <%= label_tag checkbox_id, column[:label], class: "form-check-label" %>
        </div>
      <% end %>

      <h2 class="h6 mt-4">Metadata columns</h2>
      <% if metadata_columns.any? %>
        <% metadata_columns.each do |column| %>
          <% checkbox_id = "metadata_column_#{column[:metadata_type_id]}" %>
          <div class="form-check form-switch">
            <%= check_box_tag "columns[]",
              column[:key],
              selected_column_keys.include?(column[:key]),
              id: checkbox_id,
              class: "form-check-input",
              role: "switch"
            %>
            <%= label_tag checkbox_id, column[:label], class: "form-check-label" %>
          </div>
        <% end %>
      <% else %>
        <p class="text-muted mb-0">No metadata types available.</p>
      <% end %>
    <% end %>
  </div>
</div>
