<%= form_with(
	model: content,
	data: {
		turbo_frame: local_assigns[:modal] ? "modal" : "_top",
		controller: "content-file-upload",
		action: "submit->content-file-upload#prepareSubmission",
		content_file_upload_url_value: validate_file_contents_path
	}
) do |form| %>
	<% if content.errors.any? %>
		<div class="alert alert-danger">
		<p class="mb-2"><%= pluralize(content.errors.count, "error") %> prevented this content from being saved:</p>
		<ul class="mb-0">
			<% content.errors.each do |error| %>
			<li><%= error.full_message %></li>
			<% end %>
		</ul>
		</div>
	<% end %>

	<div class="mb-3">
		<%= form.label :title, "Title", class: "form-label" %>
		<%= form.text_field :title, class: "form-control", autofocus: true %>
	</div>

	<div class="mb-3">
		<%= form.label :display_title, "Display title", class: "form-label" %>
		<%= form.text_field :display_title, class: "form-control" %>
	</div>

	<div class="mb-3">
		<%= form.label :description, "Description", class: "form-label" %>
		<%= form.text_area :description, class: "form-control", rows: 4 %>
	</div>

	<div class="mb-3">
		<%= form.label :year_of_publication, "Year of publication", class: "form-label" %>
		<%= form.number_field :year_of_publication, class: "form-control" %>
	</div>

	<div class="mb-3">
		<%= form.label :file, "File", class: "form-label" %>
		<%= form.file_field :file,
			class: "form-control",
			data: {
				action: "change->content-file-upload#upload",
				content_file_upload_target: "input"
			} %>
		<% if content.file.attached? && content.errors[:file].empty? %>
			<%= hidden_field_tag "content[file]", content.file.blob.signed_id,
				data: { content_file_upload_target: "blob" } %>
		<% end %>
		<div
			class="form-text<%= " text-success" if content.file.attached? && content.errors[:file].empty? %>"
			role="status"
			aria-live="polite"
			data-content-file-upload-target="status"
		><%= "Uploaded and validated: #{content.file.filename}" if content.file.attached? && content.errors[:file].empty? %></div>
	</div>

	<div class="mb-3">
		<label class="form-label">Metadata</label>
		<div class="form-control">
			<% selected_metadata_by_type_id = content.metadata.group_by(&:metadata_type_id) %>
			<% @metadata_types.each do |metadata_type| %>
				<div
					class="field mb-3"
					id="multiSelectFor=<%= metadata_type.id %>"
					data-controller="content-multi-select"
					data-content-multi-select-type-value="<%= metadata_type.id %>"
					data-content-multi-select-count-value="10"
				>
					<label class="form-label-sm" for="metadataInput_<%= metadata_type.id %>"><%= metadata_type.name %></label>
					<div
						class="form-control"
						id="metadataInput_<%= metadata_type.id %>_container"
						data-action="click->content-multi-select#onSearchInputClick"
					>
						<div id="metadataBadge_<%= metadata_type.id %>_container">
							<%= render partial: "contents/selected_metadatum",
								collection: selected_metadata_by_type_id.fetch(metadata_type.id, []),
								as: :metadatum %>
						</div>
						<input
							class="auto-complete border-0"
							placeholder="Search"
							id="metadataInput_<%= metadata_type.id %>"
							data-content-multi-select-target="searchInput"
							data-action="focusin->content-multi-select#onSearchFocusIn focusout->content-multi-select#onSearchFocusOut input->content-multi-select#onSearchInput"
							autocomplete="off"
							size="35"
						>
					</div>
					<div
						class="list-group d-none"
						id="metadataInput_<%= metadata_type.id %>_list"
						data-content-multi-select-target="list"
					></div>
				</div>
			<% end %>
		</div>
	</div>

	<div class="d-flex gap-2">
		<%= form.submit class: "btn btn-primary", data: { content_file_upload_target: "submit" } %>
		<%= link_to "Cancel", contents_path, class: "btn btn-secondary" %>
	</div>
<% end %>
