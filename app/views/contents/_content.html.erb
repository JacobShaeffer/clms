<% metadata_by_type = content.metadata.group_by(&:metadata_type_id) %>

<tr id="<%= dom_id content %>">
  <% selected_columns.each do |column| %>
    <td>
      <% if column[:type] == :metadata %>
        <% metadata_values = metadata_by_type.fetch(column[:metadata_type_id], []) %>
        <% if metadata_values.any? %>
          <%= metadata_values.map(&:name).join(", ") %>
        <% else %>
          <span class="text-muted">None</span>
        <% end %>
      <% else %>
        <%= content_table_value(content_column_value(content, column[:key])) %>
      <% end %>
    </td>
  <% end %>
</tr>
