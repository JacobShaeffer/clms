<div class="table-responsive">
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <% if selected_columns.any? %>
          <% selected_columns.each do |column| %>
            <% sorted = sort_column == column[:key] && sort_direction.in?(%w[asc desc]) %>
            <% current_sort_state = sorted ? sort_direction : "default" %>
            <% aria_sort = sorted ? (sort_direction == "asc" ? "ascending" : "descending") : "none" %>
            <% sort_action = if sort_direction == "asc" && sorted
              "Sort #{column[:label]} descending"
            elsif sort_direction == "desc" && sorted
              "Clear sorting for #{column[:label]}"
            else
              "Sort #{column[:label]} ascending"
            end %>

            <th scope="col" aria-sort="<%= aria_sort %>">
              <%= link_to table_contents_path(sort_column: column[:key], sort_state: current_sort_state),
                class: "link-body-emphasis text-decoration-none",
                data: { turbo_frame: "contents_table", turbo_prefetch: false },
                aria: { label: sort_action } do %>
                <%= column[:label] %>
                <% if sorted %>
                  <span aria-hidden="true"><%= sort_direction == "asc" ? "↑" : "↓" %></span>
                <% end %>
              <% end %>
            </th>
          <% end %>
        <% else %>
          <th>Columns</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% if selected_columns.empty? %>
        <tr>
          <td class="text-center">No columns selected.</td>
        </tr>
      <% elsif contents.any? %>
        <%= render partial: "content",
          collection: contents,
          locals: { selected_columns: selected_columns }
        %>
      <% else %>
        <tr>
          <td colspan="<%= selected_columns.size %>" class="text-center">No content found.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="row align-items-center mt-3">
  <div class="col">
    <%== pagy.series_nav(path: table_contents_path) if pagy.pages > 1 %>
  </div>
</div>
