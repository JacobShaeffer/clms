<div class="table-responsive">
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <% if selected_columns.any? %>
          <% selected_columns.each do |column| %>
            <th><%= column[:label] %></th>
          <% end %>
        <% else %>
          <th>Columns</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% if selected_columns.empty? %>
        <tr>
          <td class="text-center">No columns selected.</td>
        </tr>
      <% elsif contents.any? %>
        <%= render partial: "content",
          collection: contents,
          locals: { selected_columns: selected_columns }
        %>
      <% else %>
        <tr>
          <td colspan="<%= selected_columns.size %>" class="text-center">No content found.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="row align-items-center mt-3">
  <div class="col">
    <%== pagy.series_nav(path: table_contents_path) if pagy.pages > 1 %>
  </div>
</div>
