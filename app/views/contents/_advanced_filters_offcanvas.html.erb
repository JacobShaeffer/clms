<div
  class="offcanvas offcanvas-end"
  style="--bs-offcanvas-width: min(48rem, 100vw);"
  tabindex="-1"
  id="contents-advanced-filters"
  aria-labelledby="contents-advanced-filters-title">
  <div class="offcanvas-header">
    <h2 class="offcanvas-title h5" id="contents-advanced-filters-title">Advanced Filters</h2>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>

  <div class="offcanvas-body">
    <%= form_with(
      url: table_contents_path,
      method: :get,
      data: {
        controller: "content-filters-form",
        turbo_frame: "contents_table"
      }
    ) do %>
      <section>
        <h3 class="h6">General Filters</h3>

        <div class="row g-3">
          <% content_columns.each do |column| %>
            <% if column[:filter] == :date %>
              <% from_id = content_filter_input_id(column[:key], "from") %>
              <% to_id = content_filter_input_id(column[:key], "to") %>

              <div class="col-12">
                <div class="row g-2">
                  <div class="col-6">
                    <%= label_tag from_id, "#{column[:label]} from", class: "form-label" %>
                    <%= date_field_tag "filters[#{column[:key]}][from]",
                      content_filter_value(filters, column[:key], "from"),
                      id: from_id,
                      class: "form-control"
                    %>
                  </div>

                  <div class="col-6">
                    <%= label_tag to_id, "#{column[:label]} to", class: "form-label" %>
                    <%= date_field_tag "filters[#{column[:key]}][to]",
                      content_filter_value(filters, column[:key], "to"),
                      id: to_id,
                      class: "form-control"
                    %>
                  </div>
                </div>
              </div>
            <% elsif column[:filter] == :number %>
              <% input_id = content_filter_input_id(column[:key]) %>

              <div class="col-12 col-md-6">
                <%= label_tag input_id, column[:label], class: "form-label" %>
                <%= text_field_tag "filters[#{column[:key]}][value]",
                  content_filter_value(filters, column[:key]),
                  id: input_id,
                  class: "form-control",
                  inputmode: "numeric"
                %>
              </div>
            <% else %>
              <% input_id = content_filter_input_id(column[:key]) %>

              <div class="col-12 col-md-6">
                <%= label_tag input_id, column[:label], class: "form-label" %>
                <%= text_field_tag "filters[#{column[:key]}][value]",
                  content_filter_value(filters, column[:key]),
                  id: input_id,
                  class: "form-control"
                %>
              </div>
            <% end %>
          <% end %>
        </div>
      </section>

      <section class="mt-4">
        <h3 class="h6">Metadata Filters</h3>

        <% if metadata_columns.any? %>
          <div class="row g-3">
            <% metadata_columns.each do |column| %>
              <% input_id = content_filter_input_id(column[:key]) %>

              <div class="col-12 col-md-6">
                <%= label_tag input_id, column[:label], class: "form-label" %>
                <%= text_field_tag "filters[#{column[:key]}][value]",
                  content_filter_value(filters, column[:key]),
                  id: input_id,
                  class: "form-control"
                %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted mb-0">No metadata types available.</p>
        <% end %>
      </section>

      <div class="d-flex gap-2 mt-4">
        <%= submit_tag "Apply Filters", class: "btn btn-primary" %>
        <%= button_tag "Clear Filters",
          type: "submit",
          name: "clear_filters",
          value: "1",
          class: "btn btn-secondary",
          data: { action: "click->content-filters-form#clearFilters" }
        %>
      </div>
    <% end %>
  </div>
</div>
