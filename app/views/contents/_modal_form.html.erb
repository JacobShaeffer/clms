<% return_to_view = content.persisted? && params[:return_to_view] == "1" %>
<%= render layout: "shared/modal", locals: {
  title: content.persisted? ? "Edit content" : "New content",
  preserve_modal: true,
  close_path: return_to_view ? content_path(content, navigation: params[:navigation]) : nil,
  dialog_class: content.persisted? ? "modal-nearly-fullscreen content-edit-dialog" : "modal-nearly-fullscreen"
} do %>
  <% if content.persisted? %>
    <div
      class="content-edit-layout"
      data-controller="content-preview"
      data-action="content-file-upload:preview->content-preview#show content-file-upload:preview-reset->content-preview#reset"
    >
      <div class="content-edit-form">
        <%= render "contents/form", content: content, modal: true, return_to_view: %>
      </div>

      <section
        class="content-edit-preview"
        aria-label="Content preview"
        data-content-preview-target="container"
      >
        <%= render "contents/preview", content: content %>
      </section>
    </div>
  <% else %>
    <%= render "contents/form", content: content, modal: true %>
  <% end %>
<% end %>
