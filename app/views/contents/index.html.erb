<% content_for :title, "Contents" %>

<div class="row mb-3">
  <div class="col">
    <h1>Contents</h1>
  </div>
  <% if policy(Content).new? %>
    <div class="col align-self-center">
      <%= link_to "New content", new_content_path, class: "btn btn-primary float-end", data: { turbo_frame: "modal" } %>
    </div>
  <% end %>
</div>

<%= turbo_frame_tag "modal" %>

<%= render "content_tables/content_table",
  definition: @table_definition,
  state: @table_state,
  records: @contents,
  pagy: @pagy
%>
