<div class="d-inline-flex gap-1">
  <%= link_to content_path(content, navigation: navigation_token),
    class: "btn btn-sm btn-outline-primary",
    data: { turbo_frame: "modal", turbo_prefetch: false },
    aria: { label: "Preview #{content.title}" },
    title: "Preview" do %>
    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
      <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
    </svg>
  <% end %>

  <% if policy(content).edit? %>
    <%= link_to edit_content_path(content),
      class: "btn btn-sm btn-outline-secondary",
      data: { turbo_frame: "modal", turbo_prefetch: false },
      aria: { label: "Edit #{content.title}" },
      title: "Edit" do %>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
        <path d="M12.854.146a.5.5 0 0 0-.708 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zM13.5 6.207 9.793 2.5 3.293 9H3v.293L2.5 11.5l2.207-.5H5v-.293z"/>
        <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z"/>
      </svg>
    <% end %>
  <% end %>
</div>
