<div class="d-inline-flex gap-1">
  <%= link_to content_path(content, navigation: navigation_token),
    class: "btn btn-sm btn-outline-primary",
    data: { turbo_frame: "modal", turbo_prefetch: false },
    aria: { label: "Preview #{content.title}" },
    title: "Preview" do %>
    <i class="bi bi-eye" aria-hidden="true"></i>
  <% end %>

  <% if policy(content).edit? %>
    <%= link_to edit_content_path(content),
      class: "btn btn-sm btn-outline-secondary",
      data: { turbo_frame: "modal", turbo_prefetch: false },
      aria: { label: "Edit #{content.title}" },
      title: "Edit" do %>
      <i class="bi bi-pencil-square" aria-hidden="true"></i>
    <% end %>
  <% end %>
</div>
