<div
  class="auto-complete-selected d-inline-block me-1"
  id="<%= component_id %>-metadatum-<%= metadatum.id %>-badge"
  data-metadatum-id="<%= metadatum.id %>"
  data-content-multi-select-target="badge"
  data-action="mousedown->content-multi-select#onBadgeClicked"
>
  <span class="badge text-bg-primary">
    <%= metadatum.name %>
  </span>
</div>
<input
  class="d-none"
  type="checkbox"
  name="<%= input_name %>"
  id="<%= component_id %>-metadatum-<%= metadatum.id %>"
  value="<%= metadatum.id %>"
  data-content-multi-select-target="checkbox"
  checked
>
