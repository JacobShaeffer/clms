<div class="dropdown">
  <button
    class="btn btn-primary dropdown-toggle"
    type="button"
    id="<%= definition.dom_id("add-to-shelves-dropdown") %>"
    data-bs-toggle="dropdown"
    data-bs-auto-close="false"
    aria-expanded="false">
    Shelves
  </button>

  <div
    class="dropdown-menu dropdown-menu-end p-3 shadow shelf-selection-menu"
    aria-labelledby="<%= definition.dom_id("add-to-shelves-dropdown") %>">
    <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
      <h2 class="h6 mb-0">Active Shelves</h2>
      <%= link_to shelves_path,
        class: "btn btn-outline-secondary btn-sm",
        title: "Open shelves",
        aria: { label: "Open shelves" } do %>
        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
      <% end %>
    </div>

    <%= render "contents/add_to_shelves_form", definition:, active_shelves: %>
  </div>
</div>
