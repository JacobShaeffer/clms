<% content_for :title, @content.display_title %>

<div class="row mb-3">
  <div class="col">
    <h1><%= @content.display_title %></h1>
  </div>
</div>

<%= render "contents/preview", content: @content %>

<div class="d-flex gap-2 mt-3">
  <% if policy(@content).edit? %>
    <%= link_to "Edit", edit_content_path(@content), class: "btn btn-primary" %>
  <% end %>
  <%= link_to "Back to contents", contents_path, class: "btn btn-secondary" %>
</div>
