<% modal_footer = capture do %>
  <div class="d-flex gap-2 me-auto">
    <% if policy(content).trash? %>
      <%= link_to "Trash",
        trash_confirmation_content_path(content, navigation: navigation_token),
        class: "btn btn-outline-danger",
        data: { turbo_frame: "modal", turbo_prefetch: false } %>
    <% end %>
    <% if policy(content).edit? %>
      <%= link_to "Edit",
        edit_content_path(content, return_to_view: "1", navigation: navigation_token),
        class: "btn btn-outline-primary",
        data: { turbo_frame: "modal", turbo_prefetch: false } %>
    <% end %>
  </div>

  <% if previous_content %>
    <%= link_to "Previous",
      content_path(previous_content, navigation: navigation_token),
      class: "btn btn-outline-primary",
      data: { turbo_frame: "modal", turbo_prefetch: false } %>
  <% else %>
    <button type="button" class="btn btn-outline-primary" disabled>Previous</button>
  <% end %>

  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>

  <% if next_content %>
    <%= link_to "Next",
      content_path(next_content, navigation: navigation_token),
      class: "btn btn-outline-primary",
      data: { turbo_frame: "modal", turbo_prefetch: false } %>
  <% else %>
    <button type="button" class="btn btn-outline-primary" disabled>Next</button>
  <% end %>
<% end %>

<% modal_title_prefix = if selection_table_id.present?
  tag.input(
    type: "checkbox",
    id: dom_id(content, :preview_selection),
    value: content.id,
    class: "form-check-input mt-0",
    aria: { label: "Select #{content.title}" },
    data: {
      controller: "content-preview-selection",
      action: "change->content-preview-selection#change",
      content_preview_selection_content_id_value: content.id,
      content_preview_selection_table_id_value: selection_table_id
    }
  )
end %>

<%= render layout: "shared/modal", locals: {
  title: content.title,
  title_prefix: modal_title_prefix,
  preserve_modal: true,
  dialog_class: "modal-nearly-fullscreen content-edit-dialog content-view-dialog",
  title_id: dom_id(content, :preview_title),
  footer: modal_footer
} do %>
  <div class="content-edit-layout content-view-layout">
    <div class="content-edit-form content-view-details-pane">
      <%= render "contents/details", content:, metadata_types: %>
    </div>

    <section class="content-edit-preview content-view-preview" aria-label="Content preview">
      <%= render "contents/preview", content: %>
    </section>
  </div>
<% end %>
