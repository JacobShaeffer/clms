<% modal_footer = capture do %>
  <% if policy(content).trash? %>
    <%= link_to "Trash",
      trash_confirmation_content_path(content, navigation: navigation_token),
      class: "btn btn-outline-danger me-auto",
      data: { turbo_frame: "modal", turbo_prefetch: false } %>
  <% else %>
    <span class="me-auto"></span>
  <% end %>

  <% if previous_content %>
    <%= link_to "Previous",
      content_path(previous_content, navigation: navigation_token),
      class: "btn btn-outline-primary",
      data: { turbo_frame: "modal", turbo_prefetch: false } %>
  <% else %>
    <button type="button" class="btn btn-outline-primary" disabled>Previous</button>
  <% end %>

  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>

  <% if next_content %>
    <%= link_to "Next",
      content_path(next_content, navigation: navigation_token),
      class: "btn btn-outline-primary",
      data: { turbo_frame: "modal", turbo_prefetch: false } %>
  <% else %>
    <button type="button" class="btn btn-outline-primary" disabled>Next</button>
  <% end %>
<% end %>

<%= render layout: "shared/modal", locals: {
  title: content.display_title,
  dialog_class: "modal-fullscreen content-edit-dialog content-view-dialog",
  title_id: dom_id(content, :preview_title),
  footer: modal_footer
} do %>
  <div class="content-edit-layout content-view-layout">
    <div class="content-edit-form content-view-details-pane">
      <%= render "contents/details", content:, metadata_types: %>
    </div>

    <section class="content-edit-preview content-view-preview" aria-label="Content preview">
      <%= render "contents/preview", content: %>
    </section>
  </div>
<% end %>
