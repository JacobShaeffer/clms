<%= turbo_frame_tag "modal" do %>
  <% modal_title_id = local_assigns.fetch(:title_id, "modal-title") %>

  <div class="modal fade" tabindex="-1" aria-labelledby="<%= modal_title_id %>" aria-hidden="true" data-controller="modal" data-modal-preserve-value="<%= local_assigns.fetch(:preserve_modal, false) %>">
    <div class="modal-dialog <%= local_assigns[:dialog_class] %>">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="<%= modal_title_id %>"><%= title %></h1>
          <% if local_assigns[:close_path].present? %>
            <%= link_to "", close_path, class: "btn-close", aria: { label: "Close" },
              data: { turbo_frame: "modal", turbo_prefetch: false } %>
          <% else %>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          <% end %>
        </div>

        <div class="modal-body">
          <%= yield %>
        </div>

        <% if local_assigns[:footer].present? %>
          <div class="modal-footer">
            <%= local_assigns[:footer] %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
