<%= render layout: "shared/modal", locals: { title: "Delete Module" } do %>
  <p>Are you sure you want to delete <strong><%= library_module.name %></strong>?</p>

  <div class="modal-footer px-0 pb-0">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    <%= button_to "Delete",
      module_path(library_module),
      method: :delete,
      params: { module_filters: @module_filter_context },
      class: "btn btn-danger",
      form: { data: { turbo_frame: "modal" } } %>
  </div>
<% end %>
