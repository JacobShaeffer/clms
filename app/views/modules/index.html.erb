<% content_for :title, "Modules" %>

<div class="my-4" data-controller="module-filters">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Modules</h1>
    <%= link_to "New Module",
      new_module_path(module_filters: @module_filter_context),
      class: "btn btn-primary",
      data: { turbo_frame: "modal", module_filters_target: "contextLink" } %>
  </div>

  <%= form_with url: modules_path,
    method: :get,
    class: "mb-4",
    data: { turbo_frame: "module_results", module_filters_target: "form" } do |form| %>
    <%= form.label :q, "Search by name", class: "form-label" %>
    <%= form.search_field :q,
      value: @query,
      class: "form-control",
      placeholder: "Search modules by name",
      data: { module_filters_target: "query", action: "input->module-filters#search" } %>
  <% end %>

  <%= turbo_frame_tag "module_results", data: { turbo_action: "advance" }, aria: { live: "polite" } do %>
    <%= render "modules/results" %>
  <% end %>
</div>

<%= turbo_frame_tag "modal" %>
