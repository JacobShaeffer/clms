<% form_data = local_assigns[:modal] ? { turbo_frame: "modal" } : { turbo: false } %>

<%= form_with(
  model: [ library, library_folder ],
  url: library_library_folders_path(library),
  data: form_data
) do |form| %>
  <% if library_folder.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <p class="mb-2"><%= pluralize(library_folder.errors.count, "error") %> prevented this folder from being saved:</p>
      <ul class="mb-0">
        <% library_folder.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= hidden_field_tag :parent_folder_id, @parent_folder&.id %>
  <%= hidden_field_tag :tab, @active_tab %>
  <%= hidden_field_tag :shelf_id, @selected_shelf&.id if @selected_shelf %>
  <% if @picker_operation %>
    <%= hidden_field_tag :picker_operation, @picker_operation %>
    <%= hidden_field_tag :picker_folder_id, @parent_folder&.id %>
    <%= hidden_field_tag :source_folder_id, @selection.source_folder_id %>
    <% @selection.folder_ids.each do |folder_id| %>
      <%= hidden_field_tag "folder_ids[]", folder_id %>
    <% end %>
    <% @selection.content_ids.each do |content_id| %>
      <%= hidden_field_tag "content_ids[]", content_id %>
    <% end %>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control", autofocus: true, required: true %>
  </div>

  <% unless @parent_folder %>
    <div class="mb-3">
      <%= form.label :logo_id, "Library asset", class: "form-label" %>
      <%= form.collection_select :logo_id,
        @library_assets,
        :id,
        :name,
        { prompt: "Select a library asset" },
        { class: "form-select", required: true }
      %>
    </div>
  <% end %>

  <div class="modal-footer px-0 pb-0">
    <% if local_assigns[:modal] %>
      <% if @picker_operation %>
        <% picker_params = {
          source_folder_id: @selection.source_folder_id,
          folder_ids: @selection.folder_ids,
          content_ids: @selection.content_ids,
          picker_folder_id: @parent_folder&.id,
          tab: @active_tab,
          shelf_id: @selected_shelf&.id
        }.compact %>
        <% picker_path = @picker_operation == :move ?
          move_library_folder_selection_path(@library, picker_params) :
          duplicate_library_folder_selection_path(@library, picker_params) %>
        <%= link_to "Back", picker_path, class: "btn btn-secondary", data: { turbo_frame: "modal" } %>
      <% else %>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
      <% end %>
    <% end %>
    <%= form.submit "New Folder", class: "btn btn-primary" %>
  </div>
<% end %>
