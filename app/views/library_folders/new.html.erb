<% content_for :title, "New folder" %>

<div class="row justify-content-center my-4">
  <div class="col-12 col-md-8">
    <h1 class="mb-4">New folder</h1>
    <%= render "library_folders/form", library: @library, library_folder: @library_folder %>
    <%= link_to "Back to library", library_path(@library, folder_id: @parent_folder&.id, tab: @active_tab, shelf_id: @selected_shelf&.id), class: "btn btn-secondary mt-3" %>
  </div>
</div>
