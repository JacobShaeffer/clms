<% content_for :title, "Library assets" %>

<div data-controller="library-asset-filters">
  <div class="d-flex justify-content-between align-items-center my-4">
    <h1 class="mb-0">Library assets</h1>
    <%= link_to "New library asset", new_library_asset_path(library_asset_filters: @asset_filter_context), class: "btn btn-primary", data: { turbo_frame: "modal", library_asset_filters_target: "newLink" } %>
  </div>

  <%= form_with url: library_assets_path, method: :get, class: "mb-4", data: { turbo_frame: "library_asset_results", library_asset_filters_target: "form" } do |form| %>
    <div class="mb-3">
      <%= form.label :q, "Search by name", class: "form-label" %>
      <%= form.search_field :q, value: @query, class: "form-control", placeholder: "Search assets by name", data: { library_asset_filters_target: "query", action: "input->library-asset-filters#search" } %>
    </div>
    <%= form.hidden_field :language, value: @language, data: { library_asset_filters_target: "language" } %>
    <%= form.hidden_field :asset_type, value: @asset_type, data: { library_asset_filters_target: "assetType" } %>

    <% [ [ "Language", :language, LibraryAsset::LANGUAGES, @language ], [ "Type", :asset_type, LibraryAsset::ASSET_TYPES, @asset_type ] ].each do |label, field, options, selected| %>
      <fieldset class="mb-2" aria-label="<%= label %>">
        <legend class="fs-6 mb-2"><%= label %></legend>
        <div class="d-flex flex-wrap gap-2">
          <% [ "", *options ].each do |value| %>
            <%= button_tag value.presence || "All", type: "submit", name: field, value: value,
              class: "btn btn-outline-secondary #{"active" if selected == value}",
              aria: { pressed: (selected == value).to_s },
              data: { library_asset_filters_target: "button", action: "click->library-asset-filters#choose" } %>
          <% end %>
        </div>
      </fieldset>
    <% end %>
  <% end %>

  <%= turbo_frame_tag "library_asset_results", data: { turbo_action: "advance" }, aria: { live: "polite" } do %>
    <%= render "library_assets/results" %>
  <% end %>
</div>

<%= turbo_frame_tag "modal" %>
