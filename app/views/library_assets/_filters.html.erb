<%= form_with url: url, method: :get, class: "mb-4", data: { turbo_frame: frame_id, library_asset_filters_target: "form" } do |form| %>
  <% local_assigns.fetch(:context, {}).each do |key, value| %>
    <%= hidden_field_tag key, value %>
  <% end %>
  <div class="mb-3">
    <%= form.label :q, "Search by Name", for: "#{frame_id}_query", class: "form-label" %>
    <%= form.search_field :q, id: "#{frame_id}_query", value: @query, class: "form-control", placeholder: "Search Assets by Name", autofocus: local_assigns.fetch(:autofocus, false), data: { library_asset_filters_target: "query", action: "input->library-asset-filters#search" } %>
  </div>
  <%= form.hidden_field :language, id: "#{frame_id}_language", value: @language, data: { library_asset_filters_target: "language" } %>
  <%= form.hidden_field :asset_type, id: "#{frame_id}_asset_type", value: @asset_type, data: { library_asset_filters_target: "assetType" } %>

  <% groups = [ [ "Language", :language, LibraryAsset::LANGUAGES, @language ] ] %>
  <% groups << [ "Type", :asset_type, LibraryAsset::ASSET_TYPES, @asset_type ] if local_assigns.fetch(:show_type_filter, true) %>
  <% groups.each do |label, field, options, selected| %>
    <fieldset class="mb-2" aria-label="<%= label %>">
      <legend class="fs-6 mb-2"><%= label %></legend>
      <div class="d-flex flex-wrap gap-2">
        <% [ "", *options ].each do |value| %>
          <%= button_tag value.presence || "All", type: "submit", name: field, value: value,
            class: "btn btn-outline-secondary #{"active" if selected == value}",
            aria: { pressed: (selected == value).to_s },
            data: { library_asset_filters_target: "button", action: "click->library-asset-filters#choose" } %>
        <% end %>
      </div>
    </fieldset>
  <% end %>
<% end %>
