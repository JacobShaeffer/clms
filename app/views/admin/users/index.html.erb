<div class="d-flex justify-content-between align-items-center mb-3"><h1>Users</h1><%= link_to "Add user", new_admin_user_path, class: "btn btn-primary" %></div>
<%= form_with url: admin_users_path, method: :get, class: "row g-2 mb-3", role: "search" do |form| %>
  <%= hidden_field_tag :sort, @sort %>
  <%= hidden_field_tag :direction, @direction %>
  <div class="col-sm-6">
    <%= form.label :q, "Search by name or email", class: "form-label" %>
    <%= form.search_field :q, value: @query, class: "form-control" %>
  </div>
  <div class="col-auto align-self-end"><%= form.submit "Search", class: "btn btn-primary" %></div>
  <% if @query.present? %><div class="col-auto align-self-end"><%= link_to "Clear search", admin_users_path(sort: @sort, direction: @direction), class: "btn btn-outline-secondary" %></div><% end %>
<% end %>
<div class="table-responsive"><table class="table table-striped align-middle">
  <thead><tr>
    <% { "name" => "Name", "email" => "Email", "role" => "Role", "status" => "Status" }.each do |key, label| %>
      <% sorted = @sort == key %>
      <% next_direction = sorted && @direction == "asc" ? "desc" : "asc" %>
      <th scope="col" aria-sort="<%= sorted ? (@direction == 'asc' ? 'ascending' : 'descending') : 'none' %>">
        <%= link_to admin_users_path(q: @query.presence, sort: key, direction: next_direction), class: "link-body-emphasis text-decoration-none", aria: { label: "Sort #{label} #{next_direction == 'asc' ? 'ascending' : 'descending'}" } do %>
          <%= label %><% if sorted %> <span aria-hidden="true"><%= @direction == "asc" ? "↑" : "↓" %></span><% end %>
        <% end %>
      </th>
    <% end %>
    <th scope="col">Actions</th>
  </tr></thead>
  <tbody><% @users.each do |user| %><tr>
    <td><%= user.name %></td><td><%= user.email %></td><td><%= user.role.humanize %></td><td><%= user.active? ? "Active" : "Inactive" %></td>
    <td><div class="d-flex gap-2"><%= link_to "Edit", edit_admin_user_path(user), class: "btn btn-sm btn-outline-primary" %><%= button_to(user.active? ? "Deactivate" : "Reactivate", toggle_active_admin_user_path(user), method: :patch, class: "btn btn-sm btn-outline-secondary", form: { data: { turbo_confirm: user.active? ? "Deactivate #{user.name}?" : "Reactivate #{user.name}?" } }) %></div></td>
  </tr><% end %></tbody>
</table></div>
<% if @users.empty? %><p>No users found.</p><% end %>
