<tr id="<%= definition.dom_id(dom_id(record)) %>">
  <% if definition.selectable? %>
    <td class="text-center">
      <%= check_box_tag "content_ids[]",
        record.id,
        false,
        class: "form-check-input",
        form: definition.selection_form_id,
        aria: { label: "Select #{record.title}" },
        data: {
          content_table_selection_target: "row",
          action: "change->content-table-selection#update"
        }
      %>
    </td>
  <% end %>
  <% selected_columns.each do |column| %>
    <td>
      <% if column.cell_partial.present? %>
        <%= render column.cell_partial, definition:, column:, record: %>
      <% else %>
        <% value = column.value(record) %>
        <% if value.present? %>
          <%= value %>
        <% else %>
          <span class="text-muted">None</span>
        <% end %>
      <% end %>
    </td>
  <% end %>
</tr>
