<% definition.library_folders_for(record).each do |folder| %>
  <%= link_to library_path(definition.library, folder_id: folder.id, tab: "library"),
    class: "badge text-bg-secondary me-1",
    title: definition.breadcrumb_for(folder),
    data: {
      controller: "tooltip",
      bs_toggle: "tooltip",
      bs_placement: "top",
      turbo_frame: dom_id(definition.library, :folder_browser),
      turbo_action: "advance",
      turbo_prefetch: false
    } do %>
    <%= folder.name %>
  <% end %>
<% end %>
