<% search_input_id = definition.dom_id("search") %>

<div
  data-controller="content-table-selection"
  data-action="turbo:before-cache@document->content-table-selection#clearRows turbo:frame-render->content-table-selection#restoreSelection"
  <% if local_assigns[:selection_scope] %>
    data-content-table-selection-preserve-before-cache-value="true"
    data-library-content-selection-target="scope"
    data-library-content-selection-scope="<%= selection_scope %>"
  <% end %>>
<% if definition.search_enabled? || definition.filters_enabled? %>
  <div class="row mb-3">
    <div class="col">
      <%= form_with(
        url: definition.update_path,
        method: :get,
        class: "row g-2",
        data: {
          controller: "content-table-form",
          turbo_frame: definition.frame_id
        }
      ) do |form| %>
        <% if definition.search_enabled? %>
          <div class="col-12 col-md-6">
            <%= form.label :q, "Search", for: search_input_id, class: "form-label" %>
            <%= form.search_field :q,
              value: state.q,
              id: search_input_id,
              class: "form-control",
              placeholder: definition.search_placeholder,
              data: {
                action: "input->content-table-form#submit"
              }
            %>
          </div>
        <% end %>
        <% if definition.filters_enabled? %>
          <div class="col-auto align-self-end">
            <button
              class="btn btn-secondary"
              type="button"
              data-bs-toggle="offcanvas"
              data-bs-target="#<%= definition.dom_id("advanced-filters") %>"
              aria-controls="<%= definition.dom_id("advanced-filters") %>">
              Filters
            </button>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<% if definition.filters_enabled? %>
  <%= render "content_tables/advanced_filters_offcanvas", definition:, state: %>
<% end %>

<div class="row mb-3">
  <div class="col d-flex gap-2">
    <%= render "content_tables/column_select_dropdown", definition:, state: %>
    <%= button_to "Reset table",
      definition.reset_path,
      method: :delete,
      class: "btn btn-outline-secondary",
      form: { data: { turbo_frame: "_top" } }
    %>
  </div>
  <% if local_assigns[:table_actions] %>
    <div class="col-auto ms-auto">
      <%= render table_actions.fetch(:partial),
        **table_actions.fetch(:locals, {}),
        definition: definition
      %>
    </div>
  <% end %>
</div>

<%= render "content_tables/table_frame", definition:, state:, records:, pagy: %>
</div>
