<% content_for :title, "New library version" %>

<div class="row justify-content-center my-4">
  <div class="col-12 col-md-8">
    <h1 class="mb-4">New version</h1>

    <%= render "library_versions/form",
      library: @library,
      library_version: @library_version %>

    <%= link_to "Back to library", library_path(@library), class: "btn btn-secondary mt-3" %>
  </div>
</div>
