<%= form_with(model: shelf, data: { turbo_frame: "modal" }) do |form| %>
  <%= hidden_field_tag :selected_shelf_id, @selected_shelf&.id if @selected_shelf %>

  <% if shelf.errors.any? %>
    <div class="alert alert-danger">
      <p class="mb-2"><%= pluralize(shelf.errors.count, "error") %> prevented this shelf from being saved:</p>
      <ul class="mb-0">
        <% shelf.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, "Name", class: "form-label" %>
    <%= form.text_field :name, class: "form-control", autofocus: true %>
  </div>

  <div class="modal-footer px-0 pb-0">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    <%= form.submit "Create Shelf", class: "btn btn-success" %>
  </div>
<% end %>
