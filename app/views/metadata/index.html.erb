<% content_for :title, "Metadata" %>

<div class="w-100">
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <h1 class="mb-0">Metadata</h1>
    <%= link_to "New metadatum", new_metadata_type_metadatum_path(@metadata_type), class: "btn btn-primary" %>
  </div>

  <div id="metadata" class="d-grid gap-3">
    <% if @metadata.any? %>
      <% @metadata.each do |metadatum| %>
        <div class="border rounded p-3">
          <%= render metadatum, metadata_type: @metadata_type %>
          <div class="d-grid d-sm-flex gap-2 mt-3">
            <%= link_to "Show", metadata_type_metadatum_path(@metadata_type, metadatum), class: "btn btn-secondary" %>
            <%= link_to "Edit", edit_metadata_type_metadatum_path(@metadata_type, metadatum), class: "btn btn-secondary" %>
            <%= button_to "Destroy", metadata_type_metadatum_path(@metadata_type, metadatum), method: :delete, form_class: "d-grid", class: "btn btn-danger", data: { turbo_confirm: "Are you sure?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-5">No metadata found.</p>
    <% end %>
  </div>
</div>
