<% content_for :title, "Editing Metadatum" %>

<div class="row justify-content-center">
  <div class="col-12 col-md-8">
    <h1 class="mb-4">Editing Metadatum</h1>

    <%= render "form",
      metadata_type: @metadata_type,
      metadatum: @metadatum,
      url: metadata_type_metadatum_path(@metadata_type, @metadatum)
    %>

    <div class="d-grid d-sm-flex gap-2 mt-3">
      <%= link_to "Show This Metadatum", metadata_type_metadatum_path(@metadata_type, @metadatum), class: "btn btn-secondary" %>
      <%= link_to "Back to Metadata Types", metadata_types_path, class: "btn btn-secondary" %>
    </div>
  </div>
</div>
