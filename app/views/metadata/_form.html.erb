<%= form_with(model: [metadata_type, metadatum], url: url, data: { turbo_frame: "modal" }) do |form| %>
  <% if metadatum.errors.any? %>
    <div class="alert alert-danger">
      <p class="mb-2"><%= pluralize(metadatum.errors.count, "error") %> prevented this metadata value from being saved:</p>
      <ul class="mb-0">
        <% metadatum.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, "Metadata Value", class: "form-label" %>
    <%= form.text_field :name, class: "form-control", autofocus: true %>
  </div>

  <div class="form-check">
    <%= form.check_box :under_review, class: "form-check-input" %>
    <%= form.label :under_review, "Under review", class: "form-check-label" %>
  </div>

  <div class="modal-footer px-0 pb-0">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
