<header class="bg-blue-600 text-white shadow-md">
  <div class="container mx-auto px-4 py-4 flex justify-between items-center">
    <div class="text-2xl font-bold">
      <%= link_to "CLMS", root_path, class: "hover:text-blue-100" %>
    </div>
    <nav class="flex gap-6">
      <% if user_signed_in? %>
        <span class="text-sm"><%= current_user.email %></span>
        <%= link_to "Sign Out", destroy_user_session_path, method: :delete, class: "hover:text-blue-100" %>
      <% else %>
        <%= link_to "Sign In", new_user_session_path, class: "hover:text-blue-100" %>
      <% end %>
    </nav>
  </div>
</header>
