<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container-fluid">
    <a class="navbar-brand" href="<%= root_path %>">SolarHub</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle Navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="<%= metadata_types_path %>">Metadata</a>
        </li>
        <li id="content-navigation" class="nav-item dropdown d-flex">
          <a class="nav-link pe-1" href="<%= contents_path %>">Content</a>
          <% if policy(Shelf).index? %>
            <button class="nav-link dropdown-toggle dropdown-toggle-split ps-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <span class="visually-hidden">Toggle Content Menu</span>
            </button>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="<%= shelves_path %>">Shelves</a></li>
              <% if policy(Content).trash_index? %>
                <li><a class="dropdown-item" href="<%= trash_contents_path %>">Trash</a></li>
              <% end %>
            </ul>
          <% end %>
        </li>
        <li id="library-navigation" class="nav-item dropdown d-flex">
          <a class="nav-link pe-1" href="<%= libraries_path %>">Library</a>
          <% library_assets_available = policy(LibraryAsset).index? %>
          <% modules_available = policy(LibraryModule).index? %>
          <% if library_assets_available || modules_available %>
            <button class="nav-link dropdown-toggle dropdown-toggle-split ps-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <span class="visually-hidden">Toggle Library Menu</span>
            </button>
            <ul class="dropdown-menu">
              <% if library_assets_available %>
                <li><a class="dropdown-item" href="<%= library_assets_path %>">Library Assets</a></li>
              <% end %>
              <% if modules_available %>
                <li><a class="dropdown-item" href="<%= modules_path %>">Modules</a></li>
              <% end %>
            </ul>
          <% end %>
        </li>
      </ul>
      <% if user_signed_in? %>
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
          <li id="profile-navigation" class="nav-item dropdown">
            <button class="nav-link dropdown-toggle" type="button" id="profile-menu" data-bs-toggle="dropdown" aria-expanded="false">
              Profile
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profile-menu">
              <li><%= button_to "Logout", destroy_user_session_path, method: :delete, class: "dropdown-item" %></li>
            </ul>
          </li>
        </ul>
      <% else %>
        <div id="authentication-navigation" class="d-flex gap-2 ms-auto">
          <%= link_to "Sign up", new_user_registration_path, class: "btn btn-outline-primary" %>
          <%= link_to "Login", new_user_session_path, class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</nav>
